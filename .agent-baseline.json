{
  "schema_version": 1,
  "artifacts": [
    {
      "path": "AGENTS.md",
      "sources": [
        "pyproject.toml",
        ".github/workflows/check.yml",
        ".github/workflows/publish.yml",
        "skills/baseline-project/scripts/baseline.py",
        "tests/test_baseline.py",
        "tests/test_skills.py",
        "skills/__init__.py"
      ]
    },
    {
      "path": "skills/baseline-project/references/project-record.md",
      "sources": [
        "skills/baseline-project/scripts/baseline.py",
        "tests/test_baseline.py"
      ]
    },
    {
      "path": "skills/baseline-project/SKILL.md",
      "sources": [
        "pyproject.toml",
        "skills/baseline-project/scripts/baseline.py",
        "tests/test_skills.py"
      ]
    }
  ],
  "checks": [
    {
      "name": "integration-tests",
      "argv": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "cwd": ".",
      "timeout_seconds": 60
    }
  ]
}
